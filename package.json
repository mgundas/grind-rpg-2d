{
  "name": "jade-throne",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm dev:db && concurrently -n server,client,admin -c yellow,cyan,magenta \"pnpm --filter @jadethrone/server dev\" \"pnpm --filter @jadethrone/client dev\" \"pnpm --filter @jadethrone/admin dev\"",
    "dev:db": "node --env-file-if-exists=.env scripts/dev-db.mjs",
    "generate:maps": "pnpm --filter @jadethrone/data generate",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "db:generate": "pnpm --filter @jadethrone/server db:generate",
    "db:migrate": "pnpm --filter @jadethrone/server db:migrate",
    "seed": "pnpm --filter @jadethrone/server seed",
    "verify:phase3-grind": "node --import tsx scripts/verify-phase3-grind.mjs",
    "verify:phase4-economy": "node --import tsx scripts/verify-phase4-economy.mjs",
    "verify:phase4-e2e": "node scripts/verify-phase4-e2e.mjs",
    "verify:phase5-e2e": "node --env-file-if-exists=.env scripts/verify-phase5-e2e.mjs",
    "verify:phase6-e2e": "node --env-file-if-exists=.env scripts/verify-phase6-e2e.mjs",
    "dev:server": "pnpm --filter @jadethrone/server dev",
    "dev:client": "pnpm --filter @jadethrone/client dev",
    "dev:admin": "pnpm --filter @jadethrone/admin dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:phase7-e2e": "node --env-file-if-exists=.env scripts/verify-phase7-e2e.mjs",
    "verify:phase8-e2e": "node --env-file-if-exists=.env scripts/verify-phase8-e2e.mjs",
    "verify:phase9-grind": "node --import tsx scripts/verify-phase9-grind.mjs",
    "verify:phase9-e2e": "node scripts/verify-phase9-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
