# Jade Throne - example environment. Copy to `.env` and adjust.
# `.env` is machine-local and never committed.

# - Game server (dev machine) ------------------------------------------------
# 2567 is the Colyseus default; change it here only if the port is occupied.
GAME_SERVER_PORT=2567
LOG_LEVEL=info
# Simulate network latency in ms (dev only; delays both directions, so RTT doubles).
SIMULATE_LATENCY_MS=0
# Trust the first reverse-proxy hop (set to 1 behind nginx so rate limits use
# the real client IP). Leave 0 when the server is exposed directly.
TRUST_PROXY=0

# - Postgres dev database (docker-compose.yml runs on the Pi) -----------------
# On the Pi, compose uses:              POSTGRES_USER/PASSWORD/DB/PORT
# On the dev machine, the server uses:  POSTGRES_HOST/PORT (+ above) to connect.
# The server builds DATABASE_URL from these parts; an explicit DATABASE_URL
# value always wins (e.g. for CI).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jade
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=jade_throne
# DATABASE_URL=postgres://jade:change-me-dev-only@localhost:5432/jade_throne
# Dedicated database used by the DB-backed tests (`pnpm test`). The harness
# refuses URLs without "test" in them so it can never truncate dev data.
# TEST_DATABASE_URL=postgres://jade:change-me-dev-only@localhost:5432/jade_throne_test

# - Phase 2 placeholders (documented early; used from the accounts phase on) --
# Use long random values in any real deployment. Dev-only defaults are accepted
# with a warning; production rejects short/placeholder secrets.
JWT_ACCESS_SECRET=dev-only-jade-throne-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-jade-throne-refresh-secret-change-me
# Access token lifetime (seconds) and refresh token lifetime (seconds).
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-8-chars
# Dev-only test player created by `pnpm seed` (skipped when NODE_ENV=production).
SEED_TEST_EMAIL=test@example.com
SEED_TEST_USERNAME=TestPlayer
SEED_TEST_PASSWORD=test-password-123

# - Client --------------------------------------------------------------------
# Where the browser finds the game server's WebSocket endpoint (Phase 1+).
# Use "same-origin" in the production Docker build so nginx can proxy both
# matchmaking and WebSockets on the page's own host.
VITE_SERVER_URL=ws://localhost:2567

# - Production (docker-compose.prod.yml) ---------------------------------------
# The stack reads the same file. Required values there:
#   POSTGRES_PASSWORD, JWT_ACCESS_SECRET (32+), JWT_REFRESH_SECRET (32+),
#   SEED_ADMIN_PASSWORD.
# Host port for the nginx container (game + admin).
# WEB_PORT=8080
# "same-origin" makes the browser use the nginx host for matchmaking and
# WebSockets; set a full wss:// URL only for a separate game hostname.
# PUBLIC_SERVER_URL=same-origin
# Behind the bundled nginx set TRUST_PROXY=1 (first hop only).
# TRUST_PROXY=1

# - Verification scripts ------------------------------------------------------
# Optional overrides for scripts/verify-phase*.mjs (defaults to localhost).
# E2E_SERVER_URL=http://127.0.0.1:2567
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please-8-chars
# Migrations directory override for packaged deployments (defaults to ./drizzle).
# DRIZZLE_MIGRATIONS_DIR=./drizzle

