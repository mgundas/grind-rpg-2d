{
  "name": "@jadethrone/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/app.config.ts",
    "build": "esbuild src/app.config.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs --external:pg --external:pino --external:@node-rs/argon2 --external:@colyseus/monitor && esbuild src/scripts/seed.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/seed.cjs --external:pg --external:pino --external:@node-rs/argon2 --external:drizzle-orm --external:@colyseus/monitor",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.cjs",
    "seed:prod": "node dist/seed.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate-cli.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@colyseus/core": "catalog:",
    "@colyseus/monitor": "catalog:",
    "@colyseus/schema": "catalog:",
    "@colyseus/ws-transport": "catalog:",
    "@jadethrone/data": "workspace:*",
    "@jadethrone/shared": "workspace:*",
    "@node-rs/argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "jsonwebtoken": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@colyseus/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
